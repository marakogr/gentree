#!/usr/bin/env sh
# Every non-merge commit uses Conventional Commits.
set -e

msg_file="$1"
first_line="$(head -n1 "$msg_file")"

case "$first_line" in
  Merge*|Revert*|fixup!*|squash!*|"") exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .{3,}'
if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo "commit-msg: expected Conventional Commits, e.g. 'feat(desktop): add project lock (#3)'." >&2
  exit 1
fi

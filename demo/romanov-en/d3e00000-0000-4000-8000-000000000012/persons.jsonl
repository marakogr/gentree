{"schema":1,"id":"00000000-0000-4000-8000-000000000001","createdAt":"2026-10-01T09:00:00Z","updatedAt":"2026-10-01T09:00:00Z","data":{"id":"00000000-0000-4000-8000-000000000001","gender":"MALE","names":[{"given":"Alexander II","patronymic":"Nikolaevich","surname":"Romanov","prefix":null,"suffix":null,"nameType":"BIRTH","isPrimary":true}],"birth":{"start":"1818-04-29","end":"1818-04-30","precision":"DAY","qualifier":"EXACT","original":null},"death":{"start":"1881-03-13","end":"1881-03-14","precision":"DAY","qualifier":"EXACT","original":null},"notes":"Emperor of All Russia from 1855. Emancipated the serfs in 1861 and was killed by a bomb on the Catherine Canal.","externalIds":[]}}

{"schema":1,"id":"00000000-0000-4000-8000-000000000008","createdAt":"2026-10-01T09:00:00Z","updatedAt":"2026-10-01T09:00:00Z","data":{"id":"00000000-0000-4000-8000-000000000008","gender":"FEMALE","names":[{"given":"Tatiana","patronymic":"Nikolaevna","surname":"Romanova","prefix":null,"suffix":null,"nameType":"BIRTH","isPrimary":true}],"birth":{"start":"1897-06-10","end":"1897-06-11","precision":"DAY","qualifier":"EXACT","original":null},"death":{"start":"1918-07-17","end":"1918-07-18","precision":"DAY","qualifier":"EXACT","original":null},"notes":"Grand Duchess. With her sister Olga she ran a military hospital; she was the daughter closest to her mother.","externalIds":[]}}
{"schema":1,"id":"00000000-0000-4000-8000-000000000009","createdAt":"2026-10-01T09:00:00Z","updatedAt":"2026-10-01T09:00:00Z","data":{"id":"00000000-0000-4000-8000-000000000009","gender":"FEMALE","names":[{"given":"Maria","patronymic":"Nikolaevna","surname":"Romanova","prefix":null,"suffix":null,"nameType":"BIRTH","isPrimary":true}],"birth":{"start":"1899-06-26","end":"1899-06-27","precision":"DAY","qualifier":"EXACT","original":null},"death":{"start":"1918-07-17","end":"1918-07-18","precision":"DAY","qualifier":"EXACT","original":null},"notes":"Grand Duchess, known for her gentle temper and strength. In Tobolsk she nursed the sick.","externalIds":[]}}
{"schema":1,"id":"00000000-0000-4000-8000-000000000010","createdAt":"2026-10-01T09:00:00Z","updatedAt":"2026-10-01T09:00:00Z","data":{"id":"00000000-0000-4000-8000-000000000010","gender":"FEMALE","names":[{"given":"Anastasia","patronymic":"Nikolaevna","surname":"Romanova","prefix":null,"suffix":null,"nameType":"BIRTH","isPrimary":true}],"birth":{"start":"1901-06-18","end":"1901-06-19","precision":"DAY","qualifier":"EXACT","original":null},"death":{"start":"1918-07-17","end":"1918-07-18","precision":"DAY","qualifier":"EXACT","original":null},"notes":"Grand Duchess, the youngest daughter. Her fate produced many impostors after 1918.","externalIds":[]}}
{"schema":1,"id":"00000000-0000-4000-8000-000000000011","createdAt":"2026-10-01T09:00:00Z","updatedAt":"2026-10-01T09:00:00Z","data":{"id":"00000000-0000-4000-8000-000000000011","gender":"MALE","names":[{"given":"Alexei","patronymic":"Nikolaevich","surname":"Romanov","prefix":null,"suffix":null,"nameType":"BIRTH","isPrimary":true}],"birth":{"start":"1904-08-12","end":"1904-08-13","precision":"DAY","qualifier":"EXACT","original":null},"death":{"start":"1918-07-17","end":"1918-07-18","precision":"DAY","qualifier":"EXACT","original":null},"notes":"Tsesarevich and heir to the throne. He suffered from haemophilia from birth, which shaped the family's life.","externalIds":[]}}
{"schema":1,"id":"00000000-0000-4000-8000-000000000012","createdAt":"2026-10-01T09:00:00Z","updatedAt":"2026-10-01T09:00:00Z","data":{"id":"00000000-0000-4000-8000-000000000012","gender":"MALE","names":[{"given":"George","patronymic":"Alexandrovich","surname":"Romanov","prefix":null,"suffix":null,"nameType":"BIRTH","isPrimary":true}],"birth":{"start":"1871-05-09","end":"1871-05-10","precision":"DAY","qualifier":"EXACT","original":null},"death":{"start":"1899-08-10","end":"1899-08-11","precision":"DAY","qualifier":"EXACT","original":null},"notes":"Grand Duke, the second son of Alexander III. Died of tuberculosis in Abastumani, where he lived on doctors' advice.","externalIds":[]}}

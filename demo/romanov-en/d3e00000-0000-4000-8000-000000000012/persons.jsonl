{"schema":1,"id":"00000000-0000-4000-8000-000000000003","createdAt":"2026-10-01T09:00:00Z","updatedAt":"2026-10-01T09:00:00Z","data":{"id":"00000000-0000-4000-8000-000000000003","gender":"MALE","names":[{"given":"Alexander III","patronymic":"Alexandrovich","surname":"Romanov","prefix":null,"suffix":null,"nameType":"BIRTH","isPrimary":true}],"birth":{"start":"1845-03-10","end":"1845-03-11","precision":"DAY","qualifier":"EXACT","original":null},"death":{"start":"1894-11-01","end":"1894-11-02","precision":"DAY","qualifier":"EXACT","original":null},"notes":"Emperor from 1881. Lived with his family in Gatchina and kept a cautious foreign policy; died in Livadia of kidney disease.","externalIds":[]}}
{"schema":1,"id":"00000000-0000-4000-8000-000000000004","createdAt":"2026-10-01T09:00:00Z","updatedAt":"2026-10-01T09:00:00Z","data":{"id":"00000000-0000-4000-8000-000000000004","gender":"FEMALE","names":[{"given":"Maria","patronymic":"Feodorovna","surname":"Romanova","prefix":null,"suffix":null,"nameType":"BIRTH","isPrimary":true}],"birth":{"start":"1847-11-26","end":"1847-11-27","precision":"DAY","qualifier":"EXACT","original":null},"death":{"start":"1928-10-13","end":"1928-10-14","precision":"DAY","qualifier":"EXACT","original":null},"notes":"Born Princess Dagmar of Denmark. After the revolution she lived in Denmark and died at Hvidøre near Copenhagen.","externalIds":[]}}
{"schema":1,"id":"00000000-0000-4000-8000-000000000005","createdAt":"2026-10-01T09:00:00Z","updatedAt":"2026-10-01T09:00:00Z","data":{"id":"00000000-0000-4000-8000-000000000005","gender":"MALE","names":[{"given":"Nicholas II","patronymic":"Alexandrovich","surname":"Romanov","prefix":null,"suffix":null,"nameType":"BIRTH","isPrimary":true}],"birth":{"start":"1868-05-18","end":"1868-05-19","precision":"DAY","qualifier":"EXACT","original":null},"death":{"start":"1918-07-17","end":"1918-07-18","precision":"DAY","qualifier":"EXACT","original":null},"notes":"The last Emperor of All Russia, from 1894. Abdicated on 15 March 1917 and was shot with his family in Yekaterinburg.","externalIds":[]}}
{"schema":1,"id":"00000000-0000-4000-8000-000000000006","createdAt":"2026-10-01T09:00:00Z","updatedAt":"2026-10-01T09:00:00Z","data":{"id":"00000000-0000-4000-8000-000000000006","gender":"FEMALE","names":[{"given":"Alexandra","patronymic":"Feodorovna","surname":"Romanova","prefix":null,"suffix":null,"nameType":"BIRTH","isPrimary":true}],"birth":{"start":"1872-06-06","end":"1872-06-07","precision":"DAY","qualifier":"EXACT","original":null},"death":{"start":"1918-07-17","end":"1918-07-18","precision":"DAY","qualifier":"EXACT","original":null},"notes":"Born Princess Alix of Hesse-Darmstadt, a granddaughter of Queen Victoria. Colonel-in-chief of the guards and a wartime nurse.","externalIds":[]}}

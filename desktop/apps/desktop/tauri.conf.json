{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gentree",
  "version": "0.2.0",
  "identifier": "com.gentree.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gentree",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Gentree",
    "copyright": "Copyright (c) 2026 Gentree contributors",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": [],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/marakogr/gentree/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBODZFRkYyNUExOUYyM0QKUldROThobGE4dStHZXNuODE2endkNkdUVVZrY1daeVZveDl6Uk5seUpBVFRmRzlyTEZqZkFDcVIK"
    }
  }
}

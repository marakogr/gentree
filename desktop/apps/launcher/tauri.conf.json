{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gentree Launcher",
  "version": "0.4.0",
  "identifier": "com.gentree.launcher",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Gentree Launcher",
        "width": 760,
        "height": 680,
        "minWidth": 640,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": []
  }
}
